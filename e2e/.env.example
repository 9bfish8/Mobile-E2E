# Copy to .env and adjust. .env is git-ignored.

# `adb devices` 첫 번째 열. 폰이 한 대만 연결돼 있으면 비워도 됩니다.
DEVICE_UDID=

APPIUM_URL=http://127.0.0.1:4723

# QR을 비출 때까지 + 와이파이 연결까지 기다리는 시간(초)
QR_TIMEOUT=120
WIFI_TIMEOUT=60

# 재생 확인용 영상과, 재생 확인 후 지켜볼 시간(초)
YOUTUBE_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
YOUTUBE_WATCH_SECONDS=5

GATEWAY_URL=http://192.168.219.1
# 게이트웨이 페이지에 반드시 보이는 문구가 있으면 적어주세요 (비우면 "페이지가 열렸는지"만 확인)
GATEWAY_EXPECT_TEXT=
